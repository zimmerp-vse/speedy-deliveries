# Copy this file to .env and fill in values from your Supabase project.
# Vercel: set the same variables in Project Settings → Environment Variables
# (the .env file in this repo is gitignored and only used for local dev).

VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# Optional: comma-separated allow-list of origins permitted to embed the
# iframe game. Leave unset for permissive dev mode (any origin allowed).
# VITE_EMBED_ALLOWED_ORIGINS="https://your-host.example.com"
